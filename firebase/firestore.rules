rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Funções auxiliares
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isParticipant(participants) {
      return request.auth.uid in participants;
    }

    function hasUniqueParticipants(participants) {
      return participants.size() == participants.toSet().size();
    }

    function notSelfChat(participants) {
      return participants.size() > 1 && hasUniqueParticipants(participants);
    }

    function isPrivateChat(chatId) {
      return chatId != 'forum';
    }

    // Regras para inscrições na versão beta
    match /betaSignups/{signupId} {
      allow read: if true; // Permite leitura para verificar e-mails duplicados
      allow create: if true; // Permite que qualquer pessoa se inscreva
      allow update, delete: if isAuthenticated(); // Apenas usuários autenticados podem atualizar/deletar
    }

    // Regras para mensagens
    match /chats/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if false; // Não permite edição de mensagens
    }

    // Regras para conversas
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && isParticipant(resource.data.participants);
      allow create: if isAuthenticated() && isParticipant(request.resource.data.participants);
      allow update: if isAuthenticated() && isParticipant(resource.data.participants);
      allow delete: if isAuthenticated() && isParticipant(resource.data.participants);
    }

    // Perfis de usuário
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Tarefas (tasks e tarefas)
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }
    match /tarefas/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // Membros da equipe (teamMembers e membros)
    match /teamMembers/{memberId} {
      allow read, write: if isAuthenticated();
    }
    match /membros/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // Configurações gerais
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    // Logs de auditoria
    match /auditLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Configurações do usuário
    match /userSettings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Relatórios - permitir leitura e escrita para qualquer usuário autenticado
    match /reports/{reportId} {
      allow read, write: if isAuthenticated();
    }

    // Configurações do usuário (coleção configuracoes)
    match /configuracoes/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Regras para a coleção de notificações
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Regras para usuários online
    match /onlineUsers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(userId);
    }
  }
}